ru_lower = 'абвгдеёжзийклмнопрстуфхцчшщъыьэюя'
ru_upper = 'АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ'
en_lower = 'abcdefghijklmnopqrstuvwxyz'
en_upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'


def caesar(text, shift, decrypt=False):
    if decrypt:
        shift = -shift

    result = ""
    ru_lower = 'абвгдеёжзийклмнопрстуфхцчшщъыьэюя'

    for char in text:
        flag = char.isupper()
        low = char.lower()

        if 'a' <= low <= 'z':
            low = chr((ord(low) - ord('a') + shift) % 26 + ord('a'))
        elif low in ru_lower:
            low = ru_lower[(ru_lower.index(low) + shift) % 33]
        else:
            result += char
            continue

        if flag:
            low = low.upper()

        result += low

    return result


