import random


def passwords(low_reg=False, up_reg=False, spets=False, ch=False, len_pas=0):
    low_chars = list('abcdefghijklmnopqrstuvwxyz')
    up_chars = list('ABCDEFGHIJKLMNOPQRSTUVWXYZ')
    spets_chars = list('!@#$%^&*()_+-=[]{}|;:,.<>?')
    digit_chars = list('0123456789')
    if not low_reg:
        low_chars = []
    if not up_reg:
        up_chars = []
    if not spets:
        spets_chars = []
    if not ch:
        digit_chars = []
    final_chars = low_chars + up_chars + spets_chars + digit_chars
    if not final_chars or len_pas <= 0:
        return "Пароля быть не может"
    password = ""
    for _ in range(len_pas):
        password += random.choice(final_chars)
    return password

