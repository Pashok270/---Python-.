def r_i(s):
    d = {'I': 1, 'V': 5, 'X': 10, 'L': 50, 'C': 100, 'D': 500, 'M': 1000}
    res = 0
    for i in range(len(s)):
        if i + 1 < len(s) and d[s[i]] < d[s[i+1]]:
            res -= d[s[i]]
        else:
            res += d[s[i]]
    return res

def i_r(n):
    d = [(1000,'M'), (900,'CM'), (500,'D'), (400,'CD'), (100,'C'), \
        (90,'XC'), (50,'L'), (40,'XL'), (10,'X'), (9,'IX'), (5,'V'), (4,'IV'), (1,'I')]
    res = ""
    for v, sym in d:
        while n >= v:
            res += sym
            n -= v
    return res
