def print_pack_report(ch):
    for a in range(ch, 0, -1):
        if a % 5 == 0 and a % 3 == 0:
            print(f"{a} - расфасуем по 3 или по 5")
        elif a % 5 == 0 and a % 3 != 0:
            print(f"{a} - расфасуем по 5")
        elif a % 5 != 0 and a % 3 == 0:
            print(f"{a} - расфасуем по 3")
        else:
            print(f"{a} - не заказываем!")


